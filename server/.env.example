# -------------------------------
# NODE / APP CONFIG
# -------------------------------
NODE_ENV=production
PORT=4000
JWT_SECRET=your_jwt_secret_here

# -------------------------------
# POSTGRESQL
# -------------------------------
POSTGRES_DB=bazar
POSTGRES_USER=bazar
POSTGRES_PASSWORD=securepassword
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL_Local=postgresql://user:password@localhost:5432/bazar

# -------------------------------
# FIREBASE (autenticação e storage)
# -------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -------------------------------
# CLOUDINARY (uploads de imagens)
# -------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------
# REDIS (cache e jobs)
# -------------------------------
REDIS_URL=redis://redis:6379
REDIS_TOKEN=optional_redis_password_if_any

# -------------------------------
# MEILISEARCH (busca full-text)
# -------------------------------
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your_meili_master_key

# -------------------------------
# SMTP / EMAIL (envio de e-mails)
# -------------------------------
SMTP_HOST=mail.smtp.com
SMTP_PORT=587
SMTP_USER=email_user
SMTP_PASS=email_password
SMTP_FROM="Bazar Bié Okutuala <no-reply@bieokutuala.com>"
ADMIN_EMAIL=admin@bieokutuala.com

# -------------------------------
# SUPABASE (opcional)
# -------------------------------
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# -------------------------------
# DOMÍNIOS (Traefik / Frontend / Backend)
# -------------------------------
DOMAIN_WEB=bieokutuala.com
DOMAIN_SERVER=api.bieokutuala.com
TRAEFIK_EMAIL=admin@bieokutuala.com