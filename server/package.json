{
  "name": "okutuala-server",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=./.env nodemon -r dotenv/config src/index.js",
    "test": "cross-env NODE_ENV=test DATABASE_URL_LOCAL='postgresql://bazar:bazarpass@localhost:5432/bazar' jest --runInBand --silent",
    "setup:db": "node migrate_local.js postgresql://bazar:bazarpass@localhost:5432/bazar",
    "manual:migration": "node scripts/manual_migration.js postgresql://bazar:bazarpass@localhost:5432/bazar",
    "setup:sb": "node migraSb.js",
    "setup:meili": "node scripts/setupMeili.js",
    "worker:indexer": "node src/workers/indexerWorker.js",
    "swagger": "node -e 'const fs = require(\"fs\"); const swaggerSpec = require(\"./src/config/swaggerConfig.js\"); fs.writeFileSync(\"./swagger.json\", JSON.stringify(swaggerSpec, null, 2));'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-winston": "^4.2.0",
    "firebase-admin": "^12.5.0",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.40.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.12.0",
    "pg-promise": "^11.15.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.0",
    "slugify": "^1.6.6",
    "speakeasy": "^2.0.0",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
